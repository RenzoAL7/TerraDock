# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Terraform runtime data; source .tf files remain tracked
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Explicit, reviewed fixture inputs may be committed
!examples/**/*.tfvars
!examples/**/*.tfvars.json
!**/testdata/**/*.tfvars
!**/testdata/**/*.tfvars.json

# Demo session data
.terradock/
*.log

# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local toolchains and build products
.tools/
/bin/
*.test
*.out
/coverage/
/web/node_modules/
/web/dist/
/web/coverage/
/web/playwright-report/
/web/test-results/
